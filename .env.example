# Copiez ce fichier vers .env.production et renseignez les valeurs.
# Ne versionnez jamais le fichier rempli : il contient des secrets.

# URL publique du site, utilisée pour les liens absolus et le referencement.
SITE_URL=https://rnj-advisory.be

# Adresse interne du back-office Laravel.
LARAVEL_API_URL=http://backend:8000/api

# Secret partage entre le site et Laravel : la MEME valeur doit figurer dans
# backend/.env, sinon les appels entre les deux sont rejetes.
INTERNAL_API_TOKEN=

# Stripe, pour l'acompte de rendez-vous.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Origine utilisee pour construire les URL d'images.
CLOUDINARY_SITE_ORIGIN=https://rnj-advisory.be
